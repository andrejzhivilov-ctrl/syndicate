+    # default capability set, unlike every other service in this file.
+    cap_drop:
+      - ALL
     security_opt:
       - no-new-privileges:true
 
+  embeddings:
+    # Self-hosted vector model (BGE-M3, 1024 dims) so memory text never leaves
+    # the server. Deliberately NOT in eva-agent's depends_on: vector search is an
