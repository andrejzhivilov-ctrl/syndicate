+        assert len(stored["eva-syndicate/auth"]["webhook_secret"]) == 64
+        assert vault.placeholder_secrets() == {}
+        # Unseal keys land in a 0600 file and nowhere else.
+        init_file = secrets_dir / "vault-init.json"
