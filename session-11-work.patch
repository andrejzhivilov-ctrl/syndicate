+        async def scenario():
+            memory = await _memory(live_pg)
+
+            class _FailingCache:
+                async def lpush(self, *args, **kwargs):
+                    raise ConnectionError("redis went away")
+
+                async def lrange(self, *args, **kwargs):
+                    raise ConnectionError("redis went away")
