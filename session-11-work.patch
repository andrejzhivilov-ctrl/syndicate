+    build:
+      context: .
+      dockerfile: deploy/docker/embeddings.Dockerfile
+    restart: unless-stopped
+    user: "1001:1001"
+    networks:
+      - backend
+    volumes:
+      - embeddings_data:/app/model_cache
+    environment:
+      EMBEDDINGS_MODEL: ${EMBEDDINGS_MODEL:-BAAI/bge-m3}
+      EMBEDDINGS_EXPECTED_DIM: "1024"
+      EMBEDDINGS_TOKEN: ${EMBEDDINGS_TOKEN:-}
+      EMBEDDINGS_MAX_BATCH: "64"
+    cap_drop:
+      - ALL
+    security_opt:
+      - no-new-privileges:true
