+            return {
+                "status": "unavailable",
+                "value": payload,
+                "provider": self.name,
+                "warning": (
+                    f"embeddings service reports {reported} dimensions, this deployment expects "
+                    f"{self.dimensions} — semantic search stays off until they agree"
+                ),
+            }
