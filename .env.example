# EVA SYNDICATE — Environment Variables Template
# COPY to .env and fill in real values. NEVER commit .env to git.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
DOMAIN=your-domain.com

# ─── HashiCorp Vault ──────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
# Obtained from: deploy/scripts/vault_init.sh → /opt/eva/vault-secrets/eva-approle.env
VAULT_ROLE_ID=your-role-id-here
VAULT_SECRET_ID=your-secret-id-here

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=eva_syndicate
POSTGRES_USER=eva
POSTGRES_PASSWORD=generate-a-strong-password-here

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=generate-a-strong-password-here

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=generate-a-strong-password-here
N8N_HOST=your-domain.com
N8N_DB=n8n
N8N_ENCRYPTION_KEY=generate-32-char-random-string-here

# ─── Vault Unseal (for vault_unseal.sh — store in a secrets manager, NOT here) ─
# These are provided via environment when running vault_unseal.sh
# VAULT_UNSEAL_KEY_1=
# VAULT_UNSEAL_KEY_2=
# VAULT_UNSEAL_KEY_3=

# ─── Whisper STT ──────────────────────────────────────────────────────────────
# Model: large-v3 (~2.5 GB, int8 quantized, 2-3× realtime on CPU)
# Fallback options: medium (~1.2 GB), small (~500 MB)
ASR_MODEL=large-v3
ASR_QUANTIZATION=int8
ASR_THREADS=2

# ═══════════════════════════════════════════════════════════════════════════════
# THIRD-PARTY INTEGRATIONS
# ═══════════════════════════════════════════════════════════════════════════════
# All values below are DEV-ONLY fallbacks. In production every secret is read
# from Vault at secret/data/eva-syndicate/<service>. Leaving these blank in
# production is expected — the connectors will resolve via Vault.

# ─── Google Workspace (Gmail / Calendar / Drive) ─────────────────────────────
# Option A — Service Account (recommended for server-to-server, domain-wide deleg.)
#   Provide the JSON key inline (single line) OR a path to the mounted file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Subject to impersonate for domain-wide delegation (optional)
GOOGLE_WORKSPACE_SUBJECT=
# Option B — OAuth 2.0 installed-app / web refresh-token flow
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─── Telegram (HITL approval bots, agent notifications) ──────────────────────
TELEGRAM_BOT_TOKEN=
# Sam's dedicated quant-signal bot (@sam_quant_bot)
SAM_TELEGRAM_BOT_TOKEN=

# ─── MCP Gateway (Model Context Protocol tool servers) ───────────────────────
# HMAC signing key shared with trusted MCP servers (X-Marshal-Signature header)
MCP_SIGNING_KEY=generate-32-char-random-string-here
# Registry of MCP servers: "name=url,name=url" OR JSON object
MCP_SERVERS=

# ═══════════════════════════════════════════════════════════════════════════════
# VOICE PROVIDERS (Text-to-Speech / Speech-to-Text)
# ═══════════════════════════════════════════════════════════════════════════════
# Priority chains define the fallback order. First healthy provider wins.
TTS_PRIORITY=elevenlabs,xai,openai
STT_PRIORITY=whisper,groq

# ─── ElevenLabs TTS ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── xAI / Grok voice ────────────────────────────────────────────────────────
XAI_API_KEY=
XAI_TTS_ENDPOINT=https://api.x.ai/v1/audio/speech
XAI_VOICE=default

# ─── OpenAI TTS (fallback) ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ─── Groq Whisper STT (cloud fallback for local Whisper) ─────────────────────
GROQ_API_KEY=
# Local Whisper service (already provisioned in docker-compose)
WHISPER_URL=http://whisper:9000


# ═══════════════════════════════════════════════════════════════════════════════
# AGENT-LEVEL RUNTIME PARAMS (read by src/runtime_config.py at startup)
# ═══════════════════════════════════════════════════════════════════════════════
# Default HITL / notification chat for Eva-level Telegram messages.
TELEGRAM_CHAT_ID=
# Sam's dedicated quant-signal HITL chat (approve / reject / half-risk buttons).
SAM_TELEGRAM_CHAT_ID=
# Sam confluence engine tuning. Threshold = how many independent factors must
# agree before a signal is surfaced (NOT a promised win-rate). See section 1 of
# INTEGRATIONS_AND_CAPABILITIES.md for the honesty policy.
SAM_CONFLUENCE_THRESHOLD=95
# Capital protection: fraction of equity risked per trade (0.01 = 1%).
SAM_RISK_PER_TRADE=0.01
# Daily hard stop-out: max fraction of equity lost in a day before Sam freezes.
SAM_DAILY_STOP_OUT=0.03
