# ==============================================================================
# SYNDICATE v4.1 — Production Environment Variables
# Copy this file to .env before starting the stack: cp .env.example .env
# ==============================================================================

# --- Environment & Domain ---
APP_ENV=production
DOMAIN=syndicate.your-domain.com
# Кореневий каталог даних на хості (томи postgres, redis, vault, whisper, nginx-certs ...).
# Сервер: /data. Домашній ПК: наприклад /srv/syndicate-data (створити заздалегідь, права для Docker).
DATA_ROOT=/data
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16 + pgvector) ---
# New installations use the canonical database name. Existing installations
# must keep their current POSTGRES_DB until the namespace migration is approved.
# NOTE: vault_init.sh copies this password into Vault (they must match) and
# refuses to run while it still looks like a placeholder (CHANGE_ME/etc.).
POSTGRES_DB=syndicate
POSTGRES_USER=eva
POSTGRES_PASSWORD=generate_a_strong_password_here_32chars

# --- Redis 7 ---
# Passed to the server as --requirepass; also stored in Vault (see above).
REDIS_PASSWORD=generate_a_strong_redis_password_here

# --- HashiCorp Vault ---
# VAULT_ROLE_ID / VAULT_SECRET_ID are printed by deploy/scripts/vault_init.sh
# into vault-secrets/eva-agent.approle.env — copy them here (step 4.4 of the
# runbook), then delete that file. Compose refuses to start without them.
# Policies that grant those tokens are generated from src/vault_paths.py:
#   python tools/vault_policies.py --check
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=obtained_after_running_deploy_scripts_vault_init_sh
VAULT_SECRET_ID=obtained_after_running_deploy_scripts_vault_init_sh

# --- n8n Workflow Automation ---
N8N_ENCRYPTION_KEY=generate_random_encryption_key_32chars
N8N_HOST=syndicate.your-domain.com
N8N_DB=n8n

# --- Garage (directors' S3 storage, internal only) ---
# Generate on the server, never commit: openssl rand -hex 32
# (no admin token: tools/garage_setup.py uses `garage json-api` over the RPC)
GARAGE_RPC_SECRET=generate_64_hex_chars

# --- SYNDICATE API Security & Webhook Auth ---
# Master API Key for accessing /execute and /status endpoints
EVA_API_KEY=generate_secure_random_api_key_for_eva
# Shared HMAC secret for verifying incoming webhooks from Telegram / n8n
WEBHOOK_SECRET=generate_secure_webhook_hmac_secret

# --- Writable data directory (container root fs is read-only) ---
# Markdown ground-truth vault, rendered media and browser profiles live here.
# Leave empty for local dev (repository-relative paths are used).
EVA_DATA_DIR=

# --- Local Faster-Whisper ASR ---
# large-v3 потребує ~3 ГБ RAM (контейнер whisper має ліміт 3g). Слабкий ПК: small або base.
ASR_MODEL=large-v3
ASR_QUANTIZATION=int8
ASR_THREADS=2

# --- Semantic memory: self-hosted embeddings (BGE-M3) ---
# Vectors are produced inside the `embeddings` container, so memory text never
# leaves the server and PII never has to be masked before embedding (masking
# would remove exactly the identifiers an operator later searches for).
# Leave EMBEDDINGS_URL empty to disable semantic search: episodic memory keeps
# working, that is a supported mode, not a failure.
EMBEDDINGS_URL=http://embeddings:8000
EMBEDDINGS_MODEL=BAAI/bge-m3
# Must match vector(N) in config/postgres/*.sql and src/embeddings.py.
EMBEDDINGS_DIM=1024
EMBEDDINGS_TIMEOUT=30
# Optional shared secret between eva-agent and the embeddings service.
# EMBEDDINGS_TOKEN=generate_a_strong_token_here

# ==============================================================================
# External API Keys (stored in Vault via vault_init.sh or configured via Env)
# ==============================================================================
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# ELEVENLABS_API_KEY=...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# ==============================================================================
# Агенти, додані в деплой-пакет (значення — лише в Vault або секретах сервера)
# ==============================================================================
# Сховище файлів KODEX (фото, аудіо, документи). Особисті дані — поза git і з бекапом.
KODEX_DATA_DIR=/opt/eva/kodex_data
# Окремі Telegram-боти: Док і KODEX (приватні, лише Андрій у allowlist)
# TELEGRAM_BOT_TOKEN_DOC=...
# TELEGRAM_BOT_TOKEN_KODEX=...
# ID Андрія в Telegram (через кому). Порожньо = бот відмовляє всім.
# KODEX_TELEGRAM_ALLOWED_CHAT_IDS=
# YouTube Data API (Єва; вмикається лише після погодження Андрія)
# YOUTUBE_API_KEY=...

# Аліса: API-first інженерна runtime (усі activation gates закриті за замовчуванням).
# AppRole поля заповнюються лише на сервері з eva-alice.approle.env після окремого погодження.
ALICE_WORKER_ENABLED=false
ALICE_WORKER_URL=http://alice-agent:8000
ALICE_COORDINATOR_ACTIONS=capabilities
ALICE_ACTIONS=capabilities
ALICE_PROVIDERS=
ALICE_VAULT_ROLE_ID=
ALICE_VAULT_SECRET_ID=
ALICE_API_ENABLED=false
ALICE_EGRESS_ALLOWLIST_VERIFIED=false
ALICE_PROVIDER_EGRESS_NETWORK=alice-provider-egress
ALICE_MAX_REQUESTS_PER_DAY=0
ALICE_MAX_TOKENS_PER_DAY=0
ALICE_MAX_INPUT_TOKENS_PER_REQUEST=12000
ALICE_MAX_OUTPUT_TOKENS_PER_REQUEST=2048
ALICE_MAX_MODEL_CALLS_PER_REQUEST=3
ALICE_MAX_TOOL_CALLS_PER_REQUEST=8

# ── v5 pre-deploy additions (див. docs/PREDEPLOY_V5.md) ───────────────────────
# Voice overlay: ОБОВ'ЯЗКОВІ (compose відмовиться стартувати без них). Генеруй: openssl rand -hex 24 / -hex 48
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Syncthing: 127.0.0.1 (SSH-тунель) або Tailscale IP сервера. Ніколи 0.0.0.0.
SYNCTHING_BIND_IP=127.0.0.1
# Vault: авто-unseal лишається вимкненим, поки людина не вирішить інакше.
AUTO_UNSEAL=0
# Перевизначення моделей без зміни коду (перевіряй: python -m tools.check_models)
# LLM_MODEL_GEMINI_PRO=
# LLM_MODEL_GEMINI_FAST=
# LLM_MODEL_ANTHROPIC_DIRECTOR=
