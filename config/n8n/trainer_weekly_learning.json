    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000008",
      "name": "Список джерел",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "// Джерела навчання Тренера. Новий сайт також має бути в src/n8n_learning_sources.json, інакше SYNDICATE його не прийме.\nreturn [\n \"https://pubmed.ncbi.nlm.nih.gov/rss/search/1DOWGEXM0L6N-g69sm5REljY8QCTlluV-ecIShwYU7vd_OAQAb/?limit=15&utm_campaign=pubmed-2&fc=20261103113328\",\n \"https://pubmed.ncbi.nlm.nih.gov/rss/search/1fYfMzmpBkCeYUrKpE1OmpkjbxBhHgXro-jbQnj45kFBadHYYc/?limit=15&utm_campaign=pubmed-2&fc=20261103113345\",\n \"https://pubmed.ncbi.nlm.nih.gov/rss/search/1lQlR_8mqnm-USQ-UBLoK_5lOGTpaJ7J9fL-p76o77qTWsw9a-/?limit=15&utm_campaign=pubmed-2&fc=20261103113400\",\n \"https://www.frontiersin.org/journals/physiology/rss\"\n].map(url => ({json: {url}}));"
      }
    },
    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000002",
      "name": "Джерела (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueErrorOutput",
      "parameters": {"url": "={{ $json.url }}"}
    },
    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000003",
      "name": "Свіже за тиждень",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "jsCode": "const weekAgo = Date.now() - 7 * 24 * 3600 * 1000;\nconst seen = new Set();\nconst items = $input.all()\n  .filter(i => i.json.link && !seen.has(i.json.link) && seen.add(i.json.link))\n  .filter(i => !i.json.isoDate || Date.parse(i.json.isoDate) >= weekAgo)\n  .slice(0, 50)\n  .map(i => ({url: i.json.link, title: i.json.title || '', text: String(i.json.contentSnippet || i.json.content || '').slice(0, 4000)}));\nreturn [{json: {kind: 'learning', items}}];"
      }
    },
    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000004",
      "name": "Вхідні навчання Тренера",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "onError": "continueErrorOutput",
      "credentials": {"httpHeaderAuth": {"name": "SYNDICATE Тренер"}},
      "parameters": {
        "method": "POST",
        "url": "http://syndicate-agent:8000/webhook/n8n/trainer",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000005",
      "name": "Не доставлено",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1100, 120],
      "parameters": {"errorMessage": "Джерело або SYNDICATE не відповіли"}
    },
    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000006",
