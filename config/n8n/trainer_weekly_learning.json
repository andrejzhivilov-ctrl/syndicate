      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 240],
      "parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "0 5 * * 1"}]}}
    },
    {
      "id": "c2e4d9b1-0002-4b7f-8b62-000000000007",
