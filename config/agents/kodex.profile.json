  "internet": {
    "status": "approval_required",
    "rule": "жодного завантаження без явного підтвердження Андрія (approve_download)"
  },
  "delete": {
    "mode": "two_step_soft_delete",
    "trash_retention_days": 30,
    "confirm_by": "andrii"
  },
  "telegram": {
    "status": "buttons_ready_bot_pending_token",
    "module": "src/agents/kodex_buttons.py",
    "access": "andrii_only"
  },
  "reports": {"to_eva": "uploads, transformations, deletions, pending approvals"},
  "deployment_deferred": [
    "Telegram-бот: токен і chat_id",
    "Транскрибація: вибір і встановлення безкоштовного локального рушія",
    "Переклад: безкоштовний локальний рушій (вибір при деплої)",
    "Obsidian, NotebookLM, Google Drive, Sheets: експорт/імпорт — після вибору способу доступу",
    "Парсери Office/PDF: перевірка в середовищі деплою"
  ]
}
