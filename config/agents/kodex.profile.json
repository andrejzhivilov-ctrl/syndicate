  "classification": "deterministic_keyword_rules_no_paid_llm",
  "formats": {
    "native": ["md", "txt", "csv", "json"],
    "library_installed": ["docx", "xlsx", "pptx"],
    "vendored_parser": ["pdf", "epub", "html", "rtf"],
    "needs_engine": ["mp3", "wav", "m4a", "mp4 (транскрибація, безкоштовний локальний рушій)"],
    "unknown": "needs_parser → вивчення лише після підтвердження Андрія"
