  "resource_scopes": ["kodex/archive"],
  "services_enabled": [],
  "skills": [],
  "knowledge_base": {
    "shared_skill": "config/shared_skills/knowledge_base.json",
    "domains": ["andrii_medical_vault", "doc", "fin", "sam", "eva", "architect", "marshal", "kira", "shared"],
    "immutable_domain": {
      "name": "andrii_medical_vault",
      "kodex_read": true,
      "kodex_write": false,
      "kodex_delete": false,
      "rule": "ANDRII_IMMUTABLE: жоден агент не пише і не видаляє; видалення — лише вручну Андрієм"
    }
