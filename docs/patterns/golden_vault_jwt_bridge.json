{
  "name": "golden_vault_jwt_bridge",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.VAULT_BRIDGE_URL }}/token",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 8000
        }
      },
      "name": "Fetch Short-Lived JWT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "chatId": "={{ $env.ARCHITECT_ALERT_CHAT_ID }}",
        "text": "=🚨 Workflow error in '{{ $workflow.name }}': {{ $json.error || $json.message }}",
        "additionalFields": {}
      },
      "name": "Notify Marshal (OnError)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1120,
        480
      ],
      "credentials": {
        "telegramApi": {
          "id": "={{ $env.N8N_TELEGRAM_CRED_ID }}",
          "name": "ArchitectBot"
        }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Fetch Short-Lived JWT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Short-Lived JWT": {
      "main": [],
      "error": [
        [
          {
            "node": "Notify Marshal (OnError)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    "eva-syndicate",
    "architect-generated"
  ]
}