# Dedicated API-first Alice worker; no shell execution or host port is exposed.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    HOME=/tmp/alice-home \
    TMPDIR=/tmp

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/requirements-alice.txt /app/requirements-alice.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-alice.txt
COPY --chown=1001:1001 src /app/src
COPY --chown=1001:1001 deploy/runtime /app/runtime
COPY --chown=1001:1001 config/agents/alice.profile.json /app/config/agents/alice.profile.json
RUN useradd --uid 1001 --create-home --shell /usr/sbin/nologin alice \
    && mkdir -p /data/eva/data/alice /tmp/alice-home \
    && chown -R 1001:1001 /data/eva/data/alice /tmp/alice-home

USER 1001:1001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["uvicorn", "runtime.alice_runner:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
