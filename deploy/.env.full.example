# ===============================================================
# SYNDICATE — .env.example (Шаблон конфігурації)
# ІНСТРУКЦІЯ: Скопіюй цей файл як .env та заповни значення
# НІКОЛИ не комітити заповнений .env до GitHub!
# Реальні секрети — ТІЛЬКИ у HashiCorp Vault
# ===============================================================

# ── СЕРВЕР ─────────────────────────────────────────────────────
CONTABO_IP=                        # IP адреса Contabo VPS
N8N_DOMAIN=n8n.yourdomain.com      # Твій домен для N8N
EVA_DOMAIN=eva.yourdomain.com      # Домен для EVA API

# ── POSTGRESQL ─────────────────────────────────────────────────
# Пароль також зберегти у: ./secrets/postgres_password.txt
POSTGRES_PASSWORD=                  # Згенерувати: openssl rand -hex 32

# ── REDIS ──────────────────────────────────────────────────────
REDIS_PASSWORD=                     # Згенерувати: openssl rand -hex 32

# ── N8N ────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=                 # Згенерувати: openssl rand -hex 32
N8N_DB_PASSWORD=                    # = POSTGRES_PASSWORD (або окремий)

# ── HASHICORP VAULT ────────────────────────────────────────────
# Vault unsealing відбувається через vault_init.sh
# Ці значення генеруються АВТОМАТИЧНО при першому запуску Vault
VAULT_UNSEAL_KEY_1=                 # ЗБЕРІГАТИ ОФЛАЙН (USB)
VAULT_UNSEAL_KEY_2=                 # ЗБЕРІГАТИ ОФЛАЙН (USB)
VAULT_UNSEAL_KEY_3=                 # ЗБЕРІГАТИ ОФЛАЙН (USB)
VAULT_ROOT_TOKEN=                   # ЗБЕРІГАТИ ОФЛАЙН (USB)

# ── VAULT APPROLE ДЛЯ АГЕНТІВ ─────────────────────────────────
# Генеруються vault_init.sh після unseal
EVA_VAULT_ROLE_ID=
EVA_VAULT_SECRET_ID=
MARSHAL_VAULT_ROLE_ID=
MARSHAL_VAULT_SECRET_ID=
ARCHITECT_VAULT_ROLE_ID=
ARCHITECT_VAULT_SECRET_ID=
FIN_VAULT_ROLE_ID=
FIN_VAULT_SECRET_ID=
DOC_VAULT_ROLE_ID=
DOC_VAULT_SECRET_ID=
SAM_VAULT_ROLE_ID=
SAM_VAULT_SECRET_ID=

# ── LLM ПРОВАЙДЕРИ (завантажуються у Vault, не сюди напряму) ──
# Ці ключі треба завантажити в Vault через vault_init.sh
# Залишаємо тут тільки як нагадування що потрібно:
# ANTHROPIC_API_KEY=sk-ant-...       → Vault: secrets/llm/anthropic_api_key
# GEMINI_API_KEY=AIzaSy...           → Vault: secrets/llm/gemini_api_key
# GROQ_API_KEY=gsk_...               → Vault: secrets/llm/groq_api_key (для Сема: Llama-3.3-70B Free)
# PERPLEXITY_API_KEY=pplx-...        → Vault: secrets/llm/perplexity_api_key

# ── TELEGRAM БОТИ ──────────────────────────────────────────────
# Реєструємо боти через @BotFather, токени → в Vault
# TELEGRAM_EVA_BOT_TOKEN=            → Vault: secrets/communication/telegram_eva_bot
# TELEGRAM_MARSHAL_BOT_TOKEN=        → Vault: secrets/communication/telegram_marshal_bot
# TELEGRAM_ARCHITECT_BOT_TOKEN=      → Vault: secrets/communication/telegram_architect_bot
# TELEGRAM_DOC_BOT_TOKEN=            → Vault: secrets/communication/telegram_doc_bot
# TELEGRAM_SAM_BOT_TOKEN=            → Vault: secrets/communication/telegram_sam_bot
TELEGRAM_ANDRII_CHAT_ID=            # ID твого Telegram акаунту (отримай від @userinfobot)

# ── ТОРГОВІ РАХУНКИ СЕМА (ТІЛЬКИ В VAULT!) ────────────────────
# MT5_ACCOUNT=                       → Vault: secrets/trading/mt5_account
# MT5_PASSWORD=                      → Vault: secrets/trading/mt5_password
# MT5_SERVER=                        → Vault: secrets/trading/mt5_server
# IBKR_ACCOUNT=                      → Vault: secrets/trading/ibkr_account
# BINANCE_API_KEY=                   → Vault: secrets/trading/binance_api_key
# BINANCE_SECRET=                    → Vault: secrets/trading/binance_secret
# COINGLASS_API_KEY=                 → Vault: secrets/trading/coinglass_api_key

# ── GITHUB ─────────────────────────────────────────────────────
GITHUB_REPO=andrejzhivilov-ctrl/SYNDICATE
# GITHUB_TOKEN=ghp_...              → Vault: secrets/github/token

# ── SUPABASE ───────────────────────────────────────────────────
# SUPABASE_URL=                     → Vault: secrets/database/supabase_url
# SUPABASE_SERVICE_KEY=             → Vault: secrets/database/supabase_service_key
# SUPABASE_ANON_KEY=                → Vault: secrets/database/supabase_anon_key

# ── НОВА ПОШТА ─────────────────────────────────────────────────
# NOVA_POSHTA_API_KEY=              → Vault: secrets/integrations/nova_poshta

# ── ELEVENЛABS (Голос Єви) ─────────────────────────────────────
# ELEVENLABS_API_KEY=               → Vault: secrets/communication/elevenlabs
# ELEVENLABS_VOICE_ID=              # ID голосу Єви в ElevenLabs

# ── GOOGLE WORKSPACE ───────────────────────────────────────────
# GOOGLE_CLIENT_ID=                 → Vault: secrets/google/client_id
# GOOGLE_CLIENT_SECRET=             → Vault: secrets/google/client_secret
# GOOGLE_REFRESH_TOKEN=             → Vault: secrets/google/refresh_token

# ── OPENWEATHERMAP ─────────────────────────────────────────────
# OPENWEATHER_API_KEY=              → Vault: secrets/integrations/openweather

# ── БАНКИ (READ-ONLY!) ─────────────────────────────────────────
# PRIVATBANK_TOKEN=                 → Vault: secrets/financial/privatbank_token
# ABANK_TOKEN=                      → Vault: secrets/financial/abank_token

# ── CLOUDFLARE ─────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=                 # ID зони в Cloudflare
# CLOUDFLARE_API_TOKEN=             → Vault: secrets/cloudflare/api_token

# ── МОНІТОРИНГ ─────────────────────────────────────────────────
TZ=Europe/Kyiv

# ── WEBHOOK БЕЗПЕКА ────────────────────────────────────────────
# WEBHOOK_HMAC_SECRET=              → Vault: secrets/n8n/webhook_hmac_secret

# ===============================================================
# ПОРЯДОК ЗАПОВНЕННЯ:
# 1. Заповни секції СЕРВЕР, POSTGRESQL, REDIS, N8N вручну
# 2. Запусти: docker-compose up -d postgres redis vault nginx
# 3. Запусти: ./scripts/vault_init.sh (він сам згенерує решту)
# 4. Завантаж API ключі у Vault через vault_init.sh --secrets
# 5. Запусти: docker-compose up -d n8n eva
# ===============================================================
