# Renews the Vault operator token; it expires within 24h otherwise (max_lease_ttl).
# Triggered by syndicate-operator-token-renew.timer.
[Unit]
Description=SYNDICATE Vault operator token renewal
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/syndicate/scripts/renew_operator_token.py
User=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
