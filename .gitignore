# EVA SYNDICATE — Git ignore rules

# Secrets & environment
.env
.env.*
!.env.example
*.key
*.pem
vault-init.json
*-approle.env
/opt/eva/vault-secrets/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / n8n
node_modules/

# Data & runtime
/data/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated document previews (not source)
*.pdf
*.docx

# Writable runtime artefacts produced by agents (see src/data_paths.py).
# EVA_DATA_DIR relocates these in production; locally they land in the tree.
vault_md/
media/videos/
media/mockups/
!media/mockups/mockup_result.webp
config/browser_profiles/
